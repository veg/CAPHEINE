/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    CAPHEINE Nextflow hyphy config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A config file with resource allocation tailored for hyphy analyses. Appropriate
    for general use on most high performance compute environments. Assumes that all
    software is installed and available on the PATH. Runs in `local` mode - all jobs
    will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Non-MPI process-specific resource requirements
    withName:HYPHY_* {
        cpus   = { 16                   }
        memory = { 6.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }
    // Keep labeltree and cln lightweight even in the hyphy profile
    withName:HYPHY_LABELTREE_* {
        cpus   = { 1                   }
        memory = { 1.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    withName:HYPHY_CLN_* {
        cpus   = { 1                   }
        memory = { 1.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
    // BUSTED and RELAX can be more memory-hungry than other HyPhy analyses
    // Keep CPU allocation the same as other HyPhy processes, but request more memory
    withName:HYPHY_BUSTED {
        memory = { 16.GB * task.attempt }
    }
    withName:HYPHY_RELAX {
        memory = { 16.GB * task.attempt }
    }
    // MPI process-specific resource requirements
    withName:HYPHYMPI_* {
        cpus   = { 16                   }
        memory = { 6.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
}
